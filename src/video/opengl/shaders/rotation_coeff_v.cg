#pragma argument (bestprecision)
void main(float2 a_position : POSITION, float2 a_pixel : TEXCOORD0,
          out float4 position : POSITION, out float2 pixel : TEXCOORD0,
          out float2 coefficient_uv : TEXCOORD1) {
  position = float4(a_position, 0.0, 1.0);
  pixel = a_pixel;
  // Raster pixel center y+0.5 maps to texel center 2*y+0.5.
  // Only the address interpolates; the coefficient query remains nearest F32.
  coefficient_uv = float2((2.0*a_pixel.y-0.5)/1024.0,0.5);
}
